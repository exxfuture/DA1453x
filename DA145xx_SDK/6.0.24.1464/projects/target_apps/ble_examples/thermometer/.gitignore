compile_commands.json

# Eclipse CDT build configurations: the .cproject/.project/.settings and
# makefile.targets are the source of truth; everything under the per-config
# directories (makefiles, objects, deps, elf/hex/map, generated ldscripts)
# is regenerated by Eclipse and embeds machine-local absolute paths.
