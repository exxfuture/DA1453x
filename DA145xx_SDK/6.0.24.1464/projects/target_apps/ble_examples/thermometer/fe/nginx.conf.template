# nginx server config TEMPLATE for the fe image.
#
# Rendered to /etc/nginx/conf.d/default.conf at container start by
# docker/20-render-runtime-config.sh, which substitutes the three ${CSP_*}
# origins it derives from the container's API_BASE_URL / MQTT_WS_URL /
# KEYCLOAK_URL. It is a template rather than a static file precisely so the
# Content-Security-Policy can name exactly the back-end origins this deployment
# talks to (review INF-09) instead of a wildcard — one image, any environment.
#
# Port 8080, not 80: the base image is nginxinc/nginx-unprivileged (review
# INF-24), whose master process is not root and therefore cannot bind a
# privileged port. docker-compose maps 8090:8080.
#
# TLS/HSTS is deliberately absent — it belongs on the TLS-terminating reverse
# proxy in front of this container (see ../ARCHITECTURE_V3.html §12), not here.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Never advertise the exact nginx version.
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        application/xml
        image/svg+xml
        font/woff
        font/woff2;

    # The Content-Security-Policy, assembled once and referenced by the header
    # include below (a `set` in server context is visible in every location).
    #
    #  - script-src 'self' with NO nonce/hash: index.html carries no inline
    #    script — runtime config is the external /env.js (see src/config/env.ts).
    #  - style-src needs 'unsafe-inline': React and recharts set element `style`
    #    attributes, which style-src-attr blocks otherwise. Tailwind's own CSS
    #    ships as a hashed file and is covered by 'self'.
    #  - connect-src lists exactly the API, Mosquitto's WebSocket listener and
    #    Keycloak (token/userinfo/JWKS) — nothing else may be reached.
    #  - frame-src/child-src must allow the Keycloak origin: oidc-client-ts runs
    #    silent renew and session monitoring in hidden iframes pointed at it.
    #    Signing in is a top-level navigation, which CSP does not gate.
    #  - frame-ancestors 'none' replaces X-Frame-Options DENY (and outranks it
    #    where both are understood); X-Frame-Options stays for older browsers.
    set $csp "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${CSP_API_ORIGIN} ${CSP_MQTT_ORIGIN} ${CSP_KEYCLOAK_ORIGIN}; frame-src ${CSP_KEYCLOAK_ORIGIN}; child-src ${CSP_KEYCLOAK_ORIGIN}; worker-src 'self' blob:; form-action 'self' ${CSP_KEYCLOAK_ORIGIN}; manifest-src 'self'; frame-ancestors 'none'";

    include /etc/nginx/snippets/security-headers.conf;

    # Runtime configuration. Rewritten on every container start, so it must
    # never be cached: a stale env.js would point a promoted image at the
    # previous environment's API.
    location = /env.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # Content-hashed bundle output — safe to cache hard, it never changes in place.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA fallback — client-side routing (react-router) handles the rest.
    # index.html is revalidated every time, otherwise a promoted image's new
    # asset hashes would never be picked up.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # Container HEALTHCHECK target (see Dockerfile) — plain text, never cached.
    # `default_type` rather than `add_header Content-Type`: add_header APPENDS, so
    # the response would carry both nginx's default application/octet-stream and
    # text/plain.
    location = /health {
        access_log off;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 200 'ok';
    }
}
