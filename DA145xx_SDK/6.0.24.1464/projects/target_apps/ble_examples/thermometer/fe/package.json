    "@fontsource/public-sans": "^5.3.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^1.28.0",
    "mqtt": "^5.10.1",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.13.0",
    "zustand": "^4.5.5"
