# Local development only (`npm run dev` / `npm run build` for the Capacitor
# shell). Copy to .env.local — Vite loads that automatically and never commits it.
#
# In the CONTAINER these are NOT used: the image reads API_BASE_URL /
# MQTT_WS_URL / KEYCLOAK_URL from the environment at start and writes them into
# /env.js, which the browser loads before the bundle. See README.md
# ("Runtime configuration") and src/config/env.ts for the resolution order.
#
# Each of these also has a localhost default in src/config/env.ts, so the file is
# only needed when the stack is somewhere other than the compose defaults.
VITE_API_BASE_URL=http://localhost:8080
VITE_MQTT_WS_URL=ws://localhost:9001
VITE_KEYCLOAK_URL=http://localhost:8082
