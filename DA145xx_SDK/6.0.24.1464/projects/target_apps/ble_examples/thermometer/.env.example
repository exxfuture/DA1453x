# Copy to .env next to docker-compose.yml. Every value here is read by
# docker-compose.yml (which has development defaults for all of them) and by
# docker-compose.prod.yml (which has NO defaults for secrets — `docker compose
# config` fails loudly if one is missing). Never commit .env.

# --- Public entry point (prod overlay only) ---------------------------------
# Hostname the reverse proxy serves; also the FE/API/Keycloak/MQTT-WS origin.
PUBLIC_HOST=thermometer.example.com
# `internal` = Caddy's local CA (lab/LAN); an email address = ACME/Let's Encrypt.
CADDY_TLS=internal

# --- Postgres / TimescaleDB ---------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- Keycloak bootstrap admin --------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- MinIO ---------------------------------------------------------------------
MINIO_ROOT_USER=thermometer
MINIO_ROOT_PASSWORD=change-me

# --- Mosquitto dynamic-security --------------------------------------------------
# Admin client created on the broker's first start; the backend connects as it
# and provisions every other identity. Changing it later requires re-creating
# the mosquitto_data volume (docker compose down -v) or `mosquitto_ctrl dynsec
# setClientPassword`.
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=change-me
# Password the backend assigns to the `collector` client the gateways use.
MQTT_COLLECTOR_PASSWORD=change-me

# --- Backend ------------------------------------------------------------------------
# Shared secret every gateway sends as X-Device-Token on the OTA endpoints.
THERMOMETER_DEVICE_COLLECTOR_TOKEN=change-me
